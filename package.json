{
  "name": "draft-js-plugins",
  "description": "A Plugin Architecture on top of Draft.JS",
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  },
  "author": {
    "name": "Nik Graf",
    "email": "nik@nikgraf.com",
    "url": "http://www.nikgraf.com"
  },
  "dependencies": {
    "draft-js": "^0.11.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "resolutions": {
    "immutable": "^5.1.5"
  },
  "overrides": {
    "immutable": "^5.1.5"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/preset-env": "7.28.3",
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.27.1",
    "@biomejs/biome": "^2.5.10",
    "@changesets/cli": "^2.29.5",
    "@rollup/plugin-babel": "^5.3.1",
    "@rollup/plugin-node-resolve": "^14.1.0",
    "@storybook/builder-webpack5": "^6.5.16",
    "@storybook/manager-webpack5": "^6.5.16",
    "@storybook/react": "^6.5.16",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^12.1.5",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^27.5.0",
    "@types/react-dom": "^18.0.3",
    "babel-jest": "^29.7.0",
    "babel-loader": "^8.2.5",
    "babel-plugin-transform-rename-import": "^2.3.0",
    "css-loader": "6.8.1",
    "husky": "^8.0.3",
    "jest": "^27.5.1",
    "linaria": "2.1",
    "lint-staged": "^13.2.2",
    "matched": "^5.0.1",
    "multer": "^1.4.4",
    "prettier": "^3.6.2",
    "prismjs": "^1.30.0",
    "rimraf": "^5.0.7",
    "rollup": "^2.79.2",
    "style-loader": "3.3.4",
    "ts-jest": "27.1.4",
    "ts-node": "10.9.2",
    "typescript": "4.9.5",
    "webpack": "^5.102.1"
  },
  "keywords": [
    "components",
    "draft",
    "editor",
    "react",
    "react-component",
    "ux",
    "widget",
    "wysiwyg"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.(js|ts|tsx)": [
      "prettier --write",
      "biome lint --write"
    ]
  },
  "main": "lib/index.js",
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Vectorworks/draft-js-plugins.git"
  },
  "scripts": {
    "alex": "alex README.md",
    "build-storybook": "build-storybook",
    "lint": "yarn lint:biome && yarn tsc",
    "lint:biome": "biome lint ./",
    "lint:biome:fix": "biome lint --write ./",
    "storybook": "start-storybook -p 6006",
    "test": "yarn build:dts && yarn test:jest",
    "test:jest": "jest",
    "test:watch": "yarn test -- --watch",
    "build": "yarn build:dts && yarn workspaces run build",
    "build:dts": "yarn workspace @vectorworks/draft-js-plugins run build && yarn workspace @draft-js-plugins/utils run build && yarn workspace @draft-js-plugins/buttons run build",
    "prerelease": "yarn build",
    "release": "changeset publish",
    "postinstall": "husky install"
  },
  "workspaces": [
    "packages/*"
  ]
}
