{
  "name": "@vectorworks/draft-js-plugins",
  "version": "4.1.4",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "description": "Editor for DraftJS Plugins",
  "author": {
    "name": "Nik Graf",
    "email": "nik@nikgraf.com",
    "url": "http://www.nikgraf.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vectorworks/draft-js-plugins.git"
  },
  "main": "lib/index.cjs.js",
